{
  "name": "agent-wallet-mobile",
  "version": "0.2.1",
  "description": "Unofficial TypeScript client for Circle Agent Wallets on React Native and Node. Not affiliated with or endorsed by Circle.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/PROTOCOL.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/smoke.mjs",
    "prepack": "npm run build",
    "drift": "node scripts/cli-drift.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "2.4.0",
    "node-forge": "1.4.3"
  },
  "peerDependencies": {
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/node-forge": "1.3.14",
    "@x402/core": "2.31.0",
    "@x402/evm": "2.31.0",
    "typescript": "5.9.3",
    "viem": "2.56.3",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasarnedo99/agent-wallet-mobile.git"
  },
  "homepage": "https://github.com/nicolasarnedo99/agent-wallet-mobile#readme",
  "keywords": [
    "react-native",
    "x402",
    "agent-wallet",
    "usdc"
  ]
}
